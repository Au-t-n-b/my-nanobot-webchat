/** 流式 Bootstrap / 推测性渲染占位（封闭世界；无自由像素，仅用语义 variant） */
export type SduiSkeletonVariant = "text" | "rect" | "card" | "row";

export type SduiSkeletonNode = SduiOptionalId & {
