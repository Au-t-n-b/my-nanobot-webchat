/* 登录弹层与「正在进入…」态（落地页主视觉由 globals .landing-bg + Tailwind 承担） */
.backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(9, 9, 11, 0.55);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.34s ease-out, visibility 0.34s ease-out;
}

.backdropOpen {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.panel {
  /* 与 Workbench 全局 token 对齐；无 token 时 fallback 暗色工台 */
  --g-bright: var(--text-primary, #e4e4e7);
  --g-label: var(--text-secondary, #a1a1aa);
  --g-muted: var(--text-muted, #636369);
  --g-border: var(--border-subtle, rgba(255, 255, 255, 0.1));
  --g-border-strong: var(--border-strong, rgba(255, 255, 255, 0.16));
  --g-inset: var(--surface-1, #18181b);
  --panel-accent: var(--accent, #f59e0b);

  position: fixed;
  z-index: 51;
  top: 50%;
  left: 50%;
  width: min(440px, calc(100% - 32px));
  border: none;
  border-radius: 1rem;
  /* ring-1 + elevated：略透底 + backdrop 才能看见后方噪点/渐变，质感更整 */
  background: color-mix(in srgb, var(--surface-elevated, #2a2a30) 88%, transparent);
  box-shadow:
    0 0 0 1px var(--g-border),
    0 25px 50px -12px rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: var(--g-label);
  opacity: 0;
  visibility: hidden;
  /* 关闭态略偏下；位移与时长取中间值，避免过快或过慢 */
  transform: translate3d(-50%, calc(-50% + min(48vh, 360px)), 0);
  backface-visibility: hidden;
  pointer-events: none;
  transition:
    opacity 0.36s ease-out,
    transform 0.38s cubic-bezier(0.25, 0.46, 0.45, 0.94),
    visibility 0.36s ease-out;
}

.panelOpen {
  opacity: 1;
  visibility: visible;
  transform: translate3d(-50%, -50%, 0);
  pointer-events: auto;
}

.panelTop {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 28px 18px;
  margin: 0 4px;
  border-bottom: 1px solid var(--g-border);
}

.panelTitle {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--g-bright);
  margin: 0;
}

.closeBtn {
  border: 1px solid var(--g-border);
  background: rgba(0, 0, 0, 0.2);
  width: 36px;
  height: 36px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 18px;
  line-height: 1;
  color: var(--g-muted);
  flex-shrink: 0;
  transition: background-color 0.1s linear, color 0.1s linear, border-color 0.1s linear;
}

.closeBtn:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--g-bright);
  border-color: var(--g-border-strong);
}

.form {
  padding: 22px 28px 28px;
}

.lbl {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--g-label);
  margin-bottom: 8px;
  display: block;
}

.inp {
  width: 100%;
  padding: 13px 14px;
  border-radius: 10px;
  border: 1px solid var(--g-border);
  background: var(--g-inset);
  font-size: 15px;
  font-family: inherit;
  margin-bottom: 16px;
  outline: none;
  color: var(--g-bright);
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
  transition: border-color 0.1s linear, box-shadow 0.1s linear;
}

.inp:focus {
  border-color: color-mix(in srgb, var(--panel-accent) 55%, var(--g-border) 45%);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 0.05) inset,
    0 0 0 3px color-mix(in srgb, var(--panel-accent) 32%, transparent);
}

.mid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  margin-bottom: 20px;
}

.mid label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--g-muted);
  cursor: pointer;
}

.mid input[type="checkbox"] {
  accent-color: var(--panel-accent);
}

.mid a {
  color: var(--g-label);
  text-decoration: none;
  font-weight: 500;
  transition: color 0.1s linear;
}

.mid a:hover {
  color: var(--panel-accent);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.go {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 10px;
  background-color: var(--panel-accent);
  color: #0a0a0a;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: background-color 0.1s linear, transform 0.08s linear, filter 0.1s linear;
}

.go:hover {
  filter: brightness(1.06);
}

.go:active {
  transform: scale(0.99);
  filter: brightness(0.96);
}

.go:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--panel-accent) 55%, transparent);
}

.go:disabled {
  opacity: 0.72;
  cursor: wait;
  transform: none;
}

.reg {
  text-align: center;
  font-size: 13px;
  color: var(--g-muted);
  margin-top: 18px;
}

.reg a {
  color: var(--g-label);
  font-weight: 500;
  text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--g-border) 100%, transparent);
  transition: color 0.1s linear, border-bottom-color 0.1s linear;
}

.reg a:hover {
  color: var(--panel-accent);
  border-bottom-color: var(--panel-accent);
}

@media (prefers-reduced-motion: reduce) {
  .backdrop {
    transition: opacity 0.26s linear, visibility 0.26s linear;
  }
  .panel {
    transition: opacity 0.26s linear, visibility 0.26s linear, transform 0.26s linear;
  }
  .panel:not(.panelOpen) {
    transform: translate3d(-50%, -50%, 0);
  }
}

.enteringOverlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  background: rgba(5, 6, 8, 0.78);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  animation: entering-fade-in 0.06s ease-out both;
}

@keyframes entering-fade-in {
  from {
    opacity: 0.85;
  }
  to {
    opacity: 1;
  }
}

.enteringSpinner {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.12);
  border-top-color: var(--accent, #f59e0b);
  animation: entering-spin 0.7s linear infinite;
}

@keyframes entering-spin {
  to {
    transform: rotate(360deg);
  }
}

.enteringText {
  margin: 0;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: rgba(225, 232, 242, 0.92);
}
