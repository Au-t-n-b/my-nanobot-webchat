@import "tailwindcss";
/* frappe-gantt 基础样式在 layout.tsx 中 import，避免 Tailwind 从 app/ 解析裸包名失败 */
@import "../components/dashboard/frappe/frappe-gantt-theme.css";

/* 全局字体栈（与 @theme inline --font-sans 保持一致，供非 Tailwind 消费） */
:root {
  --font-sans: "Inter", "HarmonyOS Sans SC", "PingFang SC", ui-sans-serif, system-ui, sans-serif;
  /* Motion baseline: 三档时长 + 统一缓动，禁止散落的 0.15s/0.25s/0.34s 等魔法数 */
  --motion-fast: 120ms;
  --motion-base: 200ms;
  --motion-slow: 320ms;
  --ease-out: cubic-bezier(0.33, 1, 0.68, 1);

  /* ── Layout density tokens（与高度自适应联动；非 theme 相关，三主题共享） ── */
  --panel-pad: 1.25rem;        /* baseline = p-5 */
  --section-gap: 1.25rem;      /* baseline = gap-5 */
  --card-pad: 1.5rem;          /* baseline = SduiCard p-6 */
  --card-pad-compact: 0.75rem; /* baseline = SduiCard p-3 */
  --item-gap: 0.875rem;        /* baseline = gap-3.5 */
  --row-pad-y: 0.625rem;       /* baseline = py-2.5 */
}

/* 与 html[data-theme] 同步：使 dark:* 在 data-theme="dark" 下生效（默认变体为 prefers-color-scheme） */
@custom-variant dark (&:where([data-theme=dark], [data-theme=dark] *));

/* 根路径落地页：深空底 + 极弱径向聚光 + feTurbulence 噪点（无 filter:blur 全屏动画） */
.landing-bg {
  position: absolute;
  inset: 0;
  background-color: #050505;
  background-image: radial-gradient(
    circle at 50% 0%,
    color-mix(in srgb, var(--accent) 8%, transparent) 0%,
    transparent 60%
  );
  z-index: -2;
}

.noise-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  opacity: 0.04;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
  background-repeat: repeat;
  mix-blend-mode: overlay;
}

/* ─────────────────────────────────────────────
   深夜场景 — 防眩光，消除蓝紫光污染
   背景 surface-0，文字 text-primary，暖琥珀 accent
   ───────────────────────────────────────────── */
:root,
[data-theme="dark"] {
  color-scheme: dark;
  /*
   * 暗色 Z 轴（由深 → 浅，背景 token；对比度靠相邻阶差，避免 rail/card/elevated 同色）
   * surface-0 / paper-chat → canvas-rail → surface-1 → surface-2 → paper-card → surface-3 → surface-elevated
   */
  --surface-0: #09090b;
  --paper-chat: #09090b;
  --canvas-rail: #121214;
  --surface-1: #18181b;
  --surface-2: #1c1c1f;
  --paper-card: #1f1f23;
  --surface-3: #27272a;
  --surface-elevated: #2a2a30;
  /* 极弱线框，避免暗色下边框“发亮” */
  --border-subtle: rgba(255, 255, 255, 0.12);
  --border-strong: rgba(255, 255, 255, 0.16);
  --text-primary: #e4e4e7;
  --text-secondary: #a1a1aa;
  --text-muted: #7a7a82;
  --accent: #f59e0b;
  --accent-soft: rgba(245, 158, 11, 0.15);
  /* ── Discrete interaction tokens (A11y-stable, no background-dependent mixing) ── */
  --interactive-hover-bg: rgba(255, 255, 255, 0.05);
  --interactive-active-bg: rgba(255, 255, 255, 0.08);
  --interactive-selected-bg: rgba(245, 158, 11, 0.12);
  --interactive-focus-ring: rgba(245, 158, 11, 0.55);
  /* Accent interaction (discrete) */
  --accent-bg-soft: rgba(245, 158, 11, 0.14);
  --accent-border: rgba(245, 158, 11, 0.40);
  /* Danger semantic layer (token-driven) */
  --danger-bg: rgba(248, 113, 113, 0.12);
  --danger-border: rgba(248, 113, 113, 0.28);
  --danger-fg: rgba(255, 214, 214, 0.95);
  /* 状态语义：与主操作 accent 解耦 */
  --state-running: #f59e0b;
  --state-success: #34d399;
  --state-pending: #71717a;
  --success: #34d399;
  --warning: #fbbf24;
  --danger: #f87171;
  /* Layered shadow stack —— 仅环境光，inset 高光由 elevation utility 单独叠加（避免双 card 重复 inset） */
  --shadow-panel:
    0 2px 8px rgba(0, 0, 0, 0.45),
    0 8px 28px rgba(0, 0, 0, 0.35);
  --shadow-card: 0 1px 4px rgba(0, 0, 0, 0.28);
  --shadow-float:
    0 24px 64px rgba(0, 0, 0, 0.55),
    0 0 0 1px rgba(255, 255, 255, 0.08);
  /* Hairline highlight，elevation-2/3 时单独叠加 */
  --highlight-inset: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  /* Slightly more transparent: reads as a hairline, not a grey rail */
  --scrollbar-thumb: color-mix(in srgb, rgba(113, 113, 122, 0.45) 55%, transparent);

  /* SDUI v2 semantic palette (accent stays blue in dark) */
  --sdui-success: #22c55e; /* green-500 */
  --sdui-warning: #eab308; /* yellow-500 */
  --sdui-error: var(--danger);
  --sdui-accent-blue: #60a5fa; /* blue-400 for dark */
  --sdui-subtle: rgba(113, 113, 122, 0.9);
  /* ── Ambient Aurora（Arc 风格双光斑强度，Linear 骨架冷峻底色保留）
   * "底妆但看得见"：右上主光 6%，左下辅光 4%，14s 慢呼吸。 */
  --aurora-strength-1: 6%;
  --aurora-strength-2: 4%;
}

/* ─────────────────────────────────────────────
   白日场景 — 高清晰，抗环境光反射
   背景 slate-50，文字 slate-900，强阴影分层
   ───────────────────────────────────────────── */
[data-theme="light"] {
  color-scheme: light;
  --surface-elevated: #ffffff;
  --surface-0: #f8fafc;
  --surface-1: #ffffff;
  --surface-2: #f8fafc;
  --surface-3: #f1f5f9;
  --canvas-rail: #f9fafb;
  --paper-chat: #ffffff;
  --paper-card: #ffffff;
  --border-subtle: #d7dee8;
  --border-strong: #cbd5e1;
  --text-primary: #0f172a;
  --text-secondary: #334155;
  --text-muted: #66707c;
  --accent: #2563eb;
  --accent-soft: rgba(37, 99, 235, 0.10);
  /* ── Discrete interaction tokens (A11y-stable, no background-dependent mixing) ── */
  --interactive-hover-bg: rgba(15, 23, 42, 0.05);
  --interactive-active-bg: rgba(15, 23, 42, 0.08);
  --interactive-selected-bg: rgba(37, 99, 235, 0.10);
  --interactive-focus-ring: rgba(37, 99, 235, 0.55);
  /* Accent interaction (discrete) */
  --accent-bg-soft: rgba(37, 99, 235, 0.10);
  --accent-border: rgba(37, 99, 235, 0.35);
  /* Danger semantic layer (token-driven) */
  --danger-bg: rgba(220, 38, 38, 0.10);
  --danger-border: rgba(220, 38, 38, 0.22);
  --danger-fg: rgba(127, 29, 29, 0.95);
  --state-running: #d97706;
  --state-success: #059669;
  --state-pending: #94a3b8;
  --success: #059669;
  --warning: #d97706;
  --danger: #dc2626;
  --shadow-panel: 0 4px 16px rgba(15, 23, 42, 0.09), 0 1px 4px rgba(15, 23, 42, 0.06);
  --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-float: 0 24px 48px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(15, 23, 42, 0.08);
  --scrollbar-thumb: rgba(100, 116, 139, 0.40);

  /* SDUI v2 semantic palette */
  --sdui-success: #22c55e; /* green-500 */
  --sdui-warning: #eab308; /* yellow-500 */
  --sdui-error: var(--danger);
  --sdui-accent-blue: #2563eb; /* blue-600 for light */
  --sdui-subtle: rgba(100, 116, 139, 0.9);
  /* 白日下 accent 是冷蓝，压低强度避免染白底 */
  --aurora-strength-1: 2.5%;
  --aurora-strength-2: 1.5%;
}

/* ─────────────────────────────────────────────
   护眼场景 — 零蓝光，仿纸质 Sepia 阅读体验
   背景暖米色，文字 stone-700，暖棕 accent
   ───────────────────────────────────────────── */
[data-theme="soft"] {
  color-scheme: light;
  --surface-elevated: #fafaf9;
  --surface-0: #f4efe6;
  --surface-1: #fafaf9;
  --surface-2: #f5f5f4;
  --surface-3: #e7e5e4;
  --canvas-rail: #efe8de;
  --paper-chat: #fafaf9;
  --paper-card: #fafaf9;
  --border-subtle: #dfdcda;
  --border-strong: #d6d3d1;
  --text-primary: #44403c;
  --text-secondary: #78716c;
  --text-muted: #a19994;
  --accent: #b45309;
  --accent-soft: rgba(180, 83, 9, 0.12);
  /* ── Discrete interaction tokens (A11y-stable, no background-dependent mixing) ── */
  --interactive-hover-bg: rgba(68, 64, 60, 0.06);
  --interactive-active-bg: rgba(68, 64, 60, 0.10);
  --interactive-selected-bg: rgba(180, 83, 9, 0.12);
  --interactive-focus-ring: rgba(180, 83, 9, 0.55);
  /* Accent interaction (discrete) */
  --accent-bg-soft: rgba(180, 83, 9, 0.12);
  --accent-border: rgba(180, 83, 9, 0.35);
  /* Danger semantic layer (token-driven) */
  --danger-bg: rgba(185, 28, 28, 0.10);
  --danger-border: rgba(185, 28, 28, 0.22);
  --danger-fg: rgba(127, 29, 29, 0.95);
  --state-running: #b45309;
  --state-success: #4d7c0f;
  --state-pending: #a8a29e;
  --success: #4d7c0f;
  --warning: #92400e;
  --danger: #b91c1c;
  --shadow-panel: 0 4px 20px rgba(68, 64, 60, 0.10), 0 1px 4px rgba(68, 64, 60, 0.06);
  --shadow-card: 0 1px 3px rgba(68, 64, 60, 0.07);
  --shadow-float: 0 20px 40px rgba(68, 64, 60, 0.12), 0 0 0 1px rgba(68, 64, 60, 0.1);
  --scrollbar-thumb: rgba(168, 162, 158, 0.55);
}

@theme inline {
  --font-sans: "Inter", "HarmonyOS Sans SC", "PingFang SC", ui-sans-serif, system-ui, sans-serif;
  --font-mono: ui-monospace, monospace;
}

html,
body {
  background: var(--surface-0);
  color: var(--text-primary);
  font-family: "Inter", "HarmonyOS Sans SC", "PingFang SC", ui-sans-serif, system-ui, sans-serif;
}

/* ── E · Ambient Aurora 底妆（body::before，全屏 fixed，永远不被任何容器遮住） ─────────
 * 关键点：
 *  · isolation: isolate 让 body 形成自己的 stacking context，::before 用 z-index:-1 退到所有 React 子内容之下
 *  · pointer-events: none 不参与命中
 *  · 双 radial：右上主光 + 左下辅光，对角线打破死灰
 *  · 配合工作台壳"留 padding 不铺 paper-card"，光从 rail/gap 透出
 * ──────────────────────────────────────────────────────────── */
body {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
}
body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  background-image:
    radial-gradient(
      55% 45% at 100% 0%,
      color-mix(in oklab, var(--accent) var(--aurora-strength-1), transparent) 0%,
      transparent 62%
    ),
    radial-gradient(
      45% 50% at 0% 100%,
      color-mix(in oklab, var(--accent) var(--aurora-strength-2), transparent) 0%,
      transparent 62%
    );
  animation: ambient-aurora-breath 14s ease-in-out infinite;
  will-change: opacity;
}
@media (prefers-reduced-motion: reduce) {
  body::before { animation: none; }
}

@layer utilities {
  /* Legacy alias —— 与 .ui-motion 保持完全等价，避免遗留调用点失效 */
  .transition-standard {
    transition-property: all;
    transition-duration: var(--motion-base);
    transition-timing-function: var(--ease-out);
  }

  /* ─────────────────────────────────────────────
     P3 Type Scale —— 四档命名 utility，与 Linear 内部排版保持同档
     · 上调一档以缓解全屏"挤眯眼"：10/11/12/14 → 11/12.5/13.5/15
     ───────────────────────────────────────────── */
  .ui-text-eyebrow {
    font-size: 11.5px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: 0.095em;
    text-transform: uppercase;
  }
  .ui-text-label {
    font-size: 13px;
    line-height: 1.5;
  }
  .ui-text-body {
    font-size: 14.5px;
    line-height: 1.6;
  }
  .ui-text-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Ambient Aurora 由全局 body::before 接管；此处保留 className 入口，
     便于 className 上仍引用它的容器获得"局部 isolation"，但不再注入伪元素光层。 */
  .ambient-aurora { position: relative; }

  @keyframes ambient-aurora-breath {
    0%, 100% { opacity: 0.78; }
    50%      { opacity: 1; }
  }

  /* Linear 骨架式渐变 Headline（Welcome 字样专用） */
  .ui-headline-aurora {
    background-image: linear-gradient(
      135deg,
      var(--text-primary) 0%,
      var(--text-primary) 40%,
      var(--accent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* Quick-Start 气泡：surface-1 + 静默 hairline，hover 时 accent 描边发光 */
  .ui-quick-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    border-radius: 0.875rem;
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-align: left;
    transition:
      border-color var(--motion-base) var(--ease-out),
      box-shadow   var(--motion-base) var(--ease-out),
      background-color var(--motion-base) var(--ease-out),
      transform    var(--motion-fast) var(--ease-out);
    cursor: pointer;
  }
  .ui-quick-chip:hover {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--border-subtle));
    background: color-mix(in oklab, var(--accent) 4%, var(--surface-1));
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 22%, transparent),
      0 8px 24px -8px color-mix(in oklab, var(--accent) 35%, transparent);
  }
  .ui-quick-chip:active {
    transform: translateY(1px);
  }
  .ui-quick-chip:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--surface-0),
      0 0 0 4px color-mix(in oklab, var(--accent) 55%, transparent);
  }
  .ui-quick-chip-icon {
    background: color-mix(in oklab, var(--accent) 10%, var(--surface-2));
    color: var(--accent);
    transition:
      background-color var(--motion-base) var(--ease-out),
      color var(--motion-base) var(--ease-out);
  }
  .ui-quick-chip:hover .ui-quick-chip-icon {
    background: color-mix(in oklab, var(--accent) 22%, var(--surface-2));
  }

  /* ─────────────────────────────────────────────
     Follow-up Chip —— ChatArea 输入框上方的"下一步"锚点
     · 比 quick-chip 更小更克制：胶囊形 + 11px 文字
     · Hover 调用 ui-interactive 同源 token，外加淡淡 accent 描边
     ───────────────────────────────────────────── */
  .ui-followup-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 0.875rem;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    /* 默认就有"暖意"：3% accent 染底 + accent-border 30% 描边 */
    background: color-mix(in oklab, var(--accent) 3%, var(--surface-1));
    border: 1px solid color-mix(in oklab, var(--accent) 18%, var(--border-subtle));
    color: var(--text-primary);
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out);
  }
  .ui-followup-chip:hover {
    background: color-mix(in oklab, var(--accent) 10%, var(--surface-1));
    border-color: color-mix(in oklab, var(--accent) 55%, var(--border-subtle));
    color: var(--text-primary);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--accent) 25%, transparent);
  }
  .ui-followup-chip:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--accent) 50%, transparent);
  }
}

@layer components {
  /* ── Semantic primitives: keep className clean & consistent ───────────── */
  .ui-overlay {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
  }

  .ui-sheet {
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--surface-elevated) 92%, transparent);
    box-shadow: var(--shadow-float), var(--highlight-inset);
  }

  .ui-surface-chatFrame {
    border: 1px solid var(--border-subtle);
    background: var(--paper-chat);
    box-shadow: var(--shadow-panel);
  }

  .ui-surface-dashboardFrame {
    background: var(--paper-card);
    box-shadow: var(--shadow-card);
  }

  .ui-surface-rail {
    background: var(--canvas-rail);
  }

  .ui-interactive {
    transition: background-color var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out);
  }
  .ui-interactive:hover {
    background: var(--interactive-hover-bg);
  }
  .ui-interactive:active {
    background: var(--interactive-active-bg);
  }
}

/* 企业级 A11y：尊重系统「减少动效」 */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ─────────────────────────────────────────────
   SDUI v3 M1: Skeleton primitives
   ───────────────────────────────────────────── */
.ui-skeleton {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  background: color-mix(in oklab, var(--surface-3) 75%, var(--surface-2));
}
.ui-skeleton::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-60%);
  background: linear-gradient(
    90deg,
    transparent,
    color-mix(in oklab, var(--surface-1) 14%, transparent),
    transparent
  );
  animation: ui-shimmer 1.15s ease-in-out infinite;
}
@keyframes ui-shimmer {
  0% { transform: translateX(-60%); }
  100% { transform: translateX(60%); }
}

/* 反向联动：右侧预览 Tab 切换时，聊天区产物锚点闪烁提示 */
@keyframes artifact-flash {
  0% {
    background-color: var(--accent-soft);
  }
  50% {
    background-color: var(--accent);
    opacity: 0.8;
  }
  100% {
    background-color: transparent;
  }
}
.animate-artifact-flash {
  animation: artifact-flash 1.5s ease-out;
}

/* Module stepper: subtle flowing highlight */
@keyframes module-stepper-shimmer {
  0% { transform: translateX(-120%); opacity: 0; }
  20% { opacity: 0.55; }
  100% { transform: translateX(120%); opacity: 0; }
}

body {
  min-height: 100vh;
}

/* SDUI Stepper：当前步「运行中」微弱呼吸灯（不透底，仅用 ring 光晕） */
@keyframes stepper-breathe {
  0%,
  100% {
    box-shadow: 0 0 0 0 color-mix(in oklab, #2563eb 0%, transparent);
  }
  50% {
    box-shadow: 0 0 0 4px color-mix(in oklab, #2563eb 22%, transparent);
  }
}
[data-theme="dark"] .stepper-node-running {
  animation: stepper-breathe-dark 2.6s ease-in-out infinite;
}
@keyframes stepper-breathe-dark {
  0%,
  100% {
    box-shadow: 0 0 0 0 color-mix(in oklab, #38bdf8 0%, transparent);
  }
  50% {
    box-shadow: 0 0 0 5px color-mix(in oklab, #38bdf8 20%, transparent);
  }
}
.stepper-node-running {
  animation: stepper-breathe 2.6s ease-in-out infinite;
}

.ui-panel {
  background: var(--surface-1);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-panel);
}

.ui-card {
  background: var(--surface-2);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-card, none);
}

.ui-subtle {
  background: var(--surface-3);
  border: 1px solid var(--border-strong);
}

.ui-input {
  background: var(--surface-3);
  border: 1px solid var(--border-strong);
  color: var(--text-primary);
}

.ui-btn-ghost {
  color: var(--text-secondary);
}

.ui-btn-ghost:hover {
  background: var(--surface-3);
  color: var(--text-primary);
}

.ui-btn-accent {
  background: var(--accent);
  color: #fff;
}

.ui-btn-accent:hover {
  filter: brightness(1.05);
}

.ui-btn-danger-soft:hover {
  background: var(--danger-bg);
}

/* Accent button sheen sweep (for onboarding login button). */
.ui-btn-sheen {
  position: relative;
  isolation: isolate;
}
.ui-btn-sheen::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-120%) skewX(-18deg);
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.24) 35%,
    rgba(255, 255, 255, 0.12) 55%,
    transparent 100%
  );
  opacity: 0;
  z-index: 0;
}
.ui-btn-sheen:hover::after {
  opacity: 1;
  animation: ui-btn-sheen-sweep 820ms ease-out forwards;
}
@keyframes ui-btn-sheen-sweep {
  0% { transform: translateX(-120%) skewX(-18deg); }
  100% { transform: translateX(120%) skewX(-18deg); }
}

.ui-text-primary {
  color: var(--text-primary);
}

.ui-text-secondary {
  color: var(--text-secondary);
}

.ui-text-muted {
  color: var(--text-muted);
}

.ui-link {
  color: var(--accent);
}

.ui-link:hover {
  text-decoration: underline;
}

.ui-divider {
  border-color: var(--border-subtle);
}

.ui-status-running {
  color: var(--state-running);
}

.ui-status-success {
  color: var(--state-success);
}

.ui-status-warning {
  color: var(--warning);
}

.ui-status-danger {
  color: var(--danger);
}

/* ─────────────────────────────────────────────
   SDUI patch stream: continuous transition instead of repeated enter
   ───────────────────────────────────────────── */
.sdui-patch-target {
  transition:
    color 0.28s ease,
    background-color 0.28s ease,
    border-color 0.28s ease,
    box-shadow 0.28s ease;
}

.sdui-partial {
  opacity: 1;
  filter: none;
}

.sdui-transition-fill {
  transition:
    width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    x 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    y 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    stroke-dasharray 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    stroke-dashoffset 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    fill 0.3s ease,
    stroke 0.3s ease,
    opacity 0.3s ease;
}

.sdui-stepper-bar-fill {
  transition: width 0.5s linear;
}

/* ── ChatCard enter: slide-up 10px + fade-in (250ms) ── */
@keyframes chatcard-slide-up {
  0% {
    opacity: 0;
    transform: translateY(10px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
.chatcard-slide-up {
  animation: chatcard-slide-up 250ms ease-out both;
}

/* Theme-aware code styling (zinc compatibility shim removed —— 全仓已切到 token) */
[data-theme] pre,
[data-theme] code {
  border-color: var(--border-subtle) !important;
}

/* ── Custom scrollbar — 4 px, rounded thumb, transparent track ── */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) transparent;
}
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
::-webkit-scrollbar-track {
  background: transparent;
  border-radius: 999px;
}
::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: 999px;
  border: 1.5px solid transparent;
  background-clip: padding-box;
  transition: background 0.15s ease;
}
::-webkit-scrollbar-thumb:hover {
  background: color-mix(in srgb, var(--scrollbar-thumb) 100%, currentColor 15%);
  border-color: transparent;
}
::-webkit-scrollbar-corner {
  background: transparent;
}

/* ── 输入框聚焦态：使用主题 accent 色描边 ── */
.ui-input-focusable {
  outline: none;
  transition: box-shadow 0.15s ease;
}
.ui-input-focusable:focus {
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 38%, transparent);
}

/* ── 主题平滑过渡：切换深夜/白日/护眼时防硬闪 ── */
html {
  transition: background-color var(--motion-base) var(--ease-out),
    color var(--motion-base) var(--ease-out);
}

body,
.ui-panel,
.ui-card,
.ui-subtle,
.ui-input,
.ui-btn-ghost,
.ui-btn-accent,
.ui-link,
.ui-divider {
  transition-property: background-color, color, border-color, box-shadow;
  transition-duration: var(--motion-base);
  transition-timing-function: var(--ease-out);
}

/* ── Mission Control Layout ─────────────────────────────────────── */
.nav-icon-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.875rem;
  height: 2.875rem;
  padding: 0.625rem;
  border-radius: 0.75rem;
  color: var(--text-muted);
  transition: background-color var(--motion-fast) var(--ease-out),
    color var(--motion-fast) var(--ease-out);
}
.nav-icon-btn:hover {
  background-color: color-mix(in oklab, var(--text-primary) 6%, transparent);
  color: var(--text-primary);
}
.nav-icon-btn:focus-visible {
  outline-offset: 1px;
}

.writing-vertical {
  writing-mode: vertical-rl;
  letter-spacing: 0.08em;
}

/* ── Z-axis utility ladder (5 levels) ─────────────────────────────
 *   0 · 平面：纯 surface 色，无边无影（chip / inline tag）
 *   1 · 一线：hairline ring 模拟 1px 描边，零阴影 —— 主区外壳 / sidebar frame
 *   2 · 卡片：环境光 shadow + inset highlight —— 内容卡 / metric card
 *   3 · 面板：稍重的 shadow，用于侧栏 popover / dropdown
 *   4 · 浮层：最重 shadow + outer ring —— modal / dialog
 *   规则：一个元素只允许使用一种 elevation，禁止与 ring-1 / shadow-* 叠加。
 * ─────────────────────────────────────────────────────────────── */
.ui-elevation-0 {
  background: var(--surface-1);
}
.ui-elevation-1 {
  background: var(--surface-1);
  box-shadow: 0 0 0 1px var(--border-subtle);
}
.ui-elevation-2 {
  background: color-mix(in oklab, var(--surface-elevated) 78%, var(--surface-2));
  box-shadow: var(--shadow-card), var(--highlight-inset);
}
.ui-elevation-3 {
  background: var(--surface-elevated);
  box-shadow: var(--shadow-panel), var(--highlight-inset);
}
.ui-elevation-4 {
  background: var(--surface-elevated);
  box-shadow: var(--shadow-float), var(--highlight-inset);
}

/* Legacy alias —— 保留入口，统一指向 elevation-2 节奏 */
.ui-elevated-card {
  background: color-mix(in oklab, var(--surface-elevated) 78%, var(--surface-2));
  border-radius: 1rem;
  box-shadow: var(--shadow-card), var(--highlight-inset);
}

/* High-signal metric cards: alias of elevation-2 */
.ui-metric-elevated-card {
  background: color-mix(in oklab, var(--surface-elevated) 78%, var(--surface-2));
  border-radius: 1rem;
  box-shadow: var(--shadow-card), var(--highlight-inset);
}

.dashboard-container {
  container-type: inline-size;
  container-name: dashboard;
}

/* Metrics grid: auto-reflow 3→2→1 col based on dashboard container width */
.metrics-grid {
  display: grid;
  gap: 0.5rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

@container dashboard (max-width: 399px) {
  .metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@container dashboard (max-width: 259px) {
  .metrics-grid {
    grid-template-columns: 1fr;
  }
}

/* Module cards grid in ProjectOverview */
.module-cards-grid {
  display: grid;
  grid-template-columns: 1fr;
}

@container dashboard (min-width: 460px) {
  .module-cards-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@container dashboard (min-width: 700px) {
  .module-cards-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* ── 状态胶囊：等待流式时的微弱扫光（替代纯转圈压迫感） ── */
@keyframes nanobot-status-shimmer {
  0% {
    transform: translateX(-130%);
    opacity: 0;
  }
  20% {
    opacity: 0.45;
  }
  100% {
    transform: translateX(130%);
    opacity: 0;
  }
}

.nanobot-status-pill-shimmer::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 9999px;
  background: linear-gradient(
    105deg,
    transparent 0%,
    color-mix(in oklab, var(--accent) 28%, transparent) 45%,
    transparent 100%
  );
  animation: nanobot-status-shimmer 2.35s ease-in-out infinite;
  pointer-events: none;
}

/* 视口较窄时略收紧大盘正文字号与指标间距（信息密度） */
@media (max-width: 1279px) {
  .dashboard-density-viewport {
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .dashboard-density-viewport .metrics-grid {
    gap: 0.35rem;
  }
}

/* ── Viewport-height-aware density（笔记本屏纵向自适应） ── */
@media (max-height: 900px) {
  :root {
    --panel-pad: 1rem;
    --section-gap: 0.875rem;
    --card-pad: 1.125rem;
    --card-pad-compact: 0.625rem;
    --item-gap: 0.625rem;
    --row-pad-y: 0.5rem;
  }
}

@media (max-height: 720px) {
  :root {
    --panel-pad: 0.75rem;
    --section-gap: 0.625rem;
    --card-pad: 0.875rem;
    --card-pad-compact: 0.5rem;
    --item-gap: 0.5rem;
    --row-pad-y: 0.375rem;
  }
}

/*
  SDUI Patch 后子树高度突变：完整 FLIP 需在 applySduiPatch 侧测量布局。
  此处仅保留容器级过渡钩子，供后续接入 framer-motion layout 或 View Transitions。
*/
.sdui-layout-transition-hint {
  transition: opacity 200ms ease-out;
}

/* ── Motion baseline (token-driven) ───────────────────────────── */
.ui-motion {
  transition-duration: var(--motion-base);
  transition-timing-function: var(--ease-out);
}
.ui-motion-fast {
  transition-duration: var(--motion-fast);
  transition-timing-function: var(--ease-out);
}
.ui-motion-slow {
  transition-duration: var(--motion-slow);
  transition-timing-function: var(--ease-out);
}

/* ── Hover utility：替代散落的 hover-bg 杂色，统一用 text-primary 6%/10% ── */
.ui-hover-soft {
  transition: background-color var(--motion-fast) var(--ease-out),
    color var(--motion-fast) var(--ease-out);
}
.ui-hover-soft:hover {
  background-color: var(--interactive-hover-bg);
  color: var(--text-primary);
}
.ui-hover-strong {
  transition: background-color var(--motion-fast) var(--ease-out),
    color var(--motion-fast) var(--ease-out);
}
.ui-hover-strong:hover {
  background-color: var(--interactive-active-bg);
  color: var(--text-primary);
}

/* ── Global focus-visible & disabled baseline ─────────────────── */
:where(button, [role="button"], a, summary, input, select, textarea):focus-visible {
  outline: 2px solid var(--interactive-focus-ring);
  outline-offset: 2px;
  border-radius: 6px;
}
:where(button, [role="button"], a):is(:disabled, [aria-disabled="true"]) {
  opacity: 0.45;
  cursor: not-allowed;
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .ui-motion,
  .ui-motion-fast,
  .ui-motion-slow,
  .ui-hover-soft,
  .ui-hover-strong {
    transition-duration: 0.01ms !important;
  }
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
  }
  .ui-skeleton::after,
  [class*="animate-"],
  [class*="nanobot-"] {
    animation: none !important;
  }
}
