  onToggleNav,
  onOpenCommandPalette,
  onToggleZen,
  onOpenConfig,
  onOpenAppSettings,
  onOpenProfile,
  onClearSession,
  onTogglePreview,
  previewOpen,
  zenMode,
  navExpanded,
}: WorkbenchToolsMenuItemsProps) {
