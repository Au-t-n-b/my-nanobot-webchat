/** Excel 风格：绿色底；Word：蓝色底；其它中性 */
export function SduiFileKindBadge({ kind, size = "default" }: Props) {
  const lg = size === "lg";
  const base = [
    "flex shrink-0 items-center justify-center rounded-lg border font-bold",
